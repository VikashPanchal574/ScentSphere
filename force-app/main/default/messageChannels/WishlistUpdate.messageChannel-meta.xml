<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Wishlist Update</masterLabel>
    <isExposed>true</isExposed>
    <description>Notifies components when wishlist items change.</description>

    <lightningMessageFields>
        <fieldName>perfumeId</fieldName>
        <description>Updated perfume record ID.</description>
    </lightningMessageFields>

    <lightningMessageFields>
        <fieldName>isWishlisted</fieldName>
        <description>Current wishlist status.</description>
    </lightningMessageFields>
</LightningMessageChannel>
